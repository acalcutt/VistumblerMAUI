<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android36.0;net10.0-ios;net10.0-windows10.0.19041.0</TargetFrameworks>
    <!--
      macCatalyst intentionally omitted for now — WiFi scan API is not available
      on macCatalyst without special entitlements.
    -->

    <OutputType>Exe</OutputType>
    <RootNamespace>VistumblerMAUI</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>VistumblerMAUI</ApplicationTitle>
    <ApplicationId>com.vistumbler.mauiapp</ApplicationId>
    <ApplicationDisplayVersion>0.8.0</ApplicationDisplayVersion>
    <ApplicationVersion>22</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Unpackaged Windows app — no Package.appxmanifest required -->
    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>

    <!-- Universal Android APK: bundle both ABIs the MapLibre native engine ships
         (arm64-v8a for phones, x86_64 for emulators). Publishing without -r then
         produces one universal APK instead of an arm64-only build. -->
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Google Play build (dotnet publish -f net10.0-android36.0 -c Release -p:PlayStore=true): Play delivers the
       updates and doesn't allow apps it installs to update themselves, so PLAY_STORE turns the in-app updater off.
       Play only accepts app bundles, so it builds an AAB instead of the APK the GitHub/GitLab releases ship. -->
  <PropertyGroup Condition="'$(PlayStore)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <DefineConstants>$(DefineConstants);PLAY_STORE</DefineConstants>
    <AndroidPackageFormats>aab</AndroidPackageFormats>
  </PropertyGroup>

  <!-- The in-app updater (Services/AppUpdater.cs) compares this with the published releases -->
  <ItemGroup>
    <AssemblyMetadata Include="DisplayVersion" Value="$(ApplicationDisplayVersion)" />
  </ItemGroup>

  <!-- ── Android: WifiManager is part of the MAUI Android SDK. UsbSerialForAndroid (MIT, a C# port of
       usb-serial-for-android) drives USB GPS receivers' serial chips: PL2303, CP210x, FTDI, CH34x, CDC-ACM ── -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="UsbSerialForAndroid" Version="2.0.1" />
  </ItemGroup>

  <!-- ── Windows: ManagedNativeWifi for WLAN API; System.IO.Ports for serial/NMEA GPS ── -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="ManagedNativeWifi" Version="3.0.2" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.0.3" />
    <!-- The original Vistumbler's sounds (Resources/Raw/Sounds): MIT, by Gerald Versluis -->
    <PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />
    <PackageReference Include="MapLibreNative.Maui.Handlers" Version="5.0.0-pre.3" />
    <PackageReference Include="BarcodeScanning.Native.Maui" Version="3.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vistumbler.Core\Vistumbler.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#3B52CC" />
    <!-- The Vistumbler logo (RIEI-Logos/Vistumbler/VistumblerIcon.png) at 62% of a transparent canvas: Android 12+
         shows the splash icon through a circle two-thirds of its size, which would otherwise clip the logo's edge.
         White background so the blue logo stands out. -->
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#FFFFFF" BaseSize="160,160" />
    <MauiImage Include="Resources\Images\*" Exclude="Resources\Images\.gitkeep" />
    <MauiFont Include="Resources\Fonts\*" Exclude="Resources\Fonts\.gitkeep" />
    <MauiAsset Include="Resources\Raw\**" Exclude="Resources\Raw\**\.gitkeep" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Adaptive launcher icon copied from vistumbler-android: the default resource
       globs pick up the mipmap-anydpi-v26 XML but not the per-density .webp images
       they reference, so include those explicitly. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidResource Include="Platforms\Android\Resources\mipmap-*\*.webp" />
  </ItemGroup>

</Project>
