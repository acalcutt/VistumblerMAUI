<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VistumblerMAUI.ViewModels"
             xmlns:loc="clr-namespace:VistumblerMAUI.Localization"
             x:DataType="vm:ScanViewModel"
             x:Class="VistumblerMAUI.Controls.ScanControlBar">

    <!-- The scan/GPS toggles and the counts, in the title bar of each tab (Shell.TitleView), in place of the
         page's name, which the tabs already show. Bound to the singleton ScanViewModel. One row, so it fits a
         phone's title bar beside the menu button; the GPS line truncates first when it's narrow. -->
    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Padding="4,0,12,0"
          HorizontalOptions="Fill" VerticalOptions="Center">
        <Button Grid.Column="0"
                Style="{StaticResource TitleBarButton}"
                Text="{loc:T Bar_ScanAps}"
                Command="{Binding ToggleScanCommand}"
                BackgroundColor="{Binding IsScanning, Converter={StaticResource RunningToColor}}">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsScanning}" Value="True">
                    <Setter Property="Text" Value="{loc:T Bar_Stop}" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
        <Button Grid.Column="1"
                Style="{StaticResource TitleBarButton}"
                Text="{loc:T Bar_UseGps}"
                Command="{Binding ToggleGpsCommand}"
                BackgroundColor="{Binding IsGpsEnabled, Converter={StaticResource RunningToColor}}">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsGpsEnabled}" Value="True">
                    <Setter Property="Text" Value="{loc:T Bar_StopGps}" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
        <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center" HorizontalOptions="End">
            <Label Text="{Binding CountsText}" FontSize="13" HorizontalOptions="End" LineBreakMode="TailTruncation"
                   TextColor="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}" />
            <Label Text="{Binding GpsStatus}" FontSize="11" HorizontalOptions="End" LineBreakMode="TailTruncation"
                   TextColor="Gray" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
