<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's text in English, the default language and the fallback for every other. Each language is a copy of this
  file named AppResources.<code>.resx (AppResources.de.resx…) with the values translated; a string missing there shows
  in English. Keys are grouped by screen: Tab_, Menu_, Scan_, Opt_ (picker choices)…
  Text with {0} keeps its placeholders. Look up with {loc:T Key} in XAML or Loc.T("Key") in code.
-->
<root>
  <resheader name="resmimetype"><value>text/microsoft-resx</value></resheader>
  <resheader name="version"><value>2.0</value></resheader>
  <resheader name="reader"><value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value></resheader>
  <resheader name="writer"><value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value></resheader>

  <!-- Language -->
  <data name="Language_System" xml:space="preserve"><value>Phone's language</value></data>
  <data name="Settings_Language" xml:space="preserve"><value>Language</value></data>

  <!-- Tabs -->
  <data name="Tab_Scan" xml:space="preserve"><value>Scan</value></data>
  <data name="Tab_Map" xml:space="preserve"><value>Map</value></data>
