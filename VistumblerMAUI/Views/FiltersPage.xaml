<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:VistumblerMAUI.Localization"
             xmlns:vm="clr-namespace:VistumblerMAUI.ViewModels"
             x:DataType="vm:FiltersViewModel"
             x:Class="VistumblerMAUI.Views.FiltersPage"
             x:Name="Page"
             Title="{loc:T Filters_Filters}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{loc:T Filters_Add}" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="0,8" Spacing="0">
            <Label Text="{loc:T Filters_TapAFilterToUse}"
                   FontSize="12" TextColor="Gray" Margin="16,0,16,8" />

            <!-- Show all APs -->
            <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="12">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowAllCommand}" />
                </Grid.GestureRecognizers>
                <Label Grid.Column="0" Text="✓" FontAttributes="Bold" TextColor="#1565C0" WidthRequest="16"
                       IsVisible="{Binding NoFilterActive}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{loc:T Filters_NoFilterShowAllAPs}" FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,0" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Filters}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterRow">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="16,10" ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FiltersViewModel}}, Path=UseCommand, x:DataType=vm:FiltersViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="✓" FontAttributes="Bold" TextColor="#1565C0" WidthRequest="16"
                                       IsVisible="{Binding IsActive}" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Text="{Binding Summary}" FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="{loc:T Filters_Edit}" FontSize="12" Padding="8,0" HeightRequest="32"
                                        BackgroundColor="Transparent" TextColor="#1565C0" VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FiltersViewModel}}, Path=EditCommand, x:DataType=vm:FiltersViewModel}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="3" Text="{loc:T Filters_Delete}" FontSize="12" Padding="8,0" HeightRequest="32"
                                        BackgroundColor="Transparent" TextColor="#B00020" VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FiltersViewModel}}, Path=DeleteCommand, x:DataType=vm:FiltersViewModel}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="{loc:T Filters_NoSavedFiltersYetTap}"
                   IsVisible="{Binding HasFilters, Converter={StaticResource InvertBool}}"
                   FontSize="12" TextColor="Gray" Margin="16,12" />
            <Button Text="{loc:T Filters_AddAFilter}" Command="{Binding AddCommand}" Margin="16,12" HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
