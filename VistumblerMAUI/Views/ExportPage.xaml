<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:VistumblerMAUI.Localization"
             xmlns:vm="clr-namespace:VistumblerMAUI.ViewModels"
             x:DataType="vm:ExportViewModel"
             x:Class="VistumblerMAUI.Views.ExportPage"
             Title="{loc:T Export_Export}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,8">

            <Label Text="{loc:T Export_FORMAT}" Style="{StaticResource SectionHeader}" />
            <Picker Margin="16,0"
                    ItemsSource="{Binding Formats}"
                    SelectedItem="{Binding SelectedFormat}" />
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,8" />

            <!-- The original's "Filtered APs" exports, when a filter is in use (Filters on the Scan page) -->
            <Grid ColumnDefinitions="*,Auto" Padding="16,4,16,8" IsVisible="{Binding HasActiveFilter}">
                <Label Grid.Column="0" Text="{Binding FilteredOnlyText}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding FilteredOnly}" />
            </Grid>

            <Label Text="{loc:T Export_FILENAME}" Style="{StaticResource SectionHeader}" />
            <Entry Margin="16,0" Text="{Binding FileName}" Placeholder="{loc:T Export_VistumblerExport}" />
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,8" />

            <Label Text="{loc:T Export_LOCATION}" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="*,Auto" Margin="16,0" ColumnSpacing="8">
                <Label Grid.Column="0"
                       Text="{Binding ExportFolder}"
                       LineBreakMode="HeadTruncation"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="{loc:T Settings_Browse}"
                        Command="{Binding BrowseFolderCommand}"
                        Padding="12,0"
                        HeightRequest="36" />
            </Grid>
            <Button Text="{loc:T Settings_UseDefaultFolder}"
                    Command="{Binding UseDefaultFolderCommand}"
                    IsVisible="{Binding IsCustomFolder}"
                    Margin="16,8,16,0"
                    HorizontalOptions="Start"
                    Padding="12,0"
                    HeightRequest="32"
                    BackgroundColor="Transparent"
                    TextColor="Gray" />
            <Label Text="{loc:T Export_TheFileIsOfferedTo}"
                   FontSize="12" TextColor="Gray"
                   Margin="16,8,16,0" />
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,8" />

            <!-- KML-only options -->
            <StackLayout IsVisible="{Binding SelectedFormat, Converter={StaticResource IsKmlFormat}}">
                <Label Text="{loc:T Export_KMLOPTIONS}" Style="{StaticResource SectionHeader}" />
                <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                    <Label Grid.Column="0" Text="{loc:T Export_IncludeOpenNetworks}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding IncludeOpenNetworks}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                    <Label Grid.Column="0" Text="{loc:T Export_IncludeWEPNetworks}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding IncludeWepNetworks}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                    <Label Grid.Column="0" Text="{loc:T Export_IncludeSecureNetworks}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding IncludeSecureNetworks}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                    <Label Grid.Column="0" Text="{loc:T Export_ColourPinsBySignal}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding UseSignalColors}" />
                </Grid>
                <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,8" />
            </StackLayout>

            <!-- Track-capable formats (KML/GPX) -->
            <StackLayout IsVisible="{Binding SelectedFormat, Converter={StaticResource IsTrackFormat}}">
                <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                    <Label Grid.Column="0" Text="{loc:T Export_IncludeGPSTrack}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding IncludeGpsTrack}" />
                </Grid>
                <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,8" />
            </StackLayout>

            <Button Text="{loc:T Export_Export}"
                    Command="{Binding ExportCommand}"
                    Margin="16,16,16,4"
                    HorizontalOptions="Fill" />

            <Button Text="{loc:T Common_Cancel}"
                    Command="{Binding CancelCommand}"
                    Margin="16,0,16,8"
                    HorizontalOptions="Fill"
                    BackgroundColor="Transparent"
                    TextColor="Gray" />

            <ActivityIndicator IsRunning="{Binding IsExporting}" IsVisible="{Binding IsExporting}" Margin="16,0" />

            <Label Text="{Binding StatusMessage}"
                   FontSize="12" TextColor="Gray"
                   Margin="16,8" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
