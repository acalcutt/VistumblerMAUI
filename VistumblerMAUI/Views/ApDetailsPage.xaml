<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:VistumblerMAUI.Localization"
             xmlns:vm="clr-namespace:VistumblerMAUI.ViewModels"
             x:DataType="vm:ApDetailsViewModel"
             x:Class="VistumblerMAUI.Views.ApDetailsPage"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{loc:T ApDetails_Copy}" Command="{Binding CopyCommand}" />
        <ToolbarItem Text="{loc:T ApDetails_WifiDB}" Command="{Binding LocateInWifiDbCommand}" />
        <ToolbarItem Text="{loc:T Tab_Map}" Command="{Binding ShowOnMapCommand}" />
        <ToolbarItem Text="{loc:T ApDetails_Back}" Clicked="OnBackClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Button Text="{loc:T ApDetails_BackToScanList}"
                    Clicked="OnBackClicked"
                    HorizontalOptions="Start"
                    BackgroundColor="Transparent" TextColor="#1565C0" Padding="0"
                    FontSize="14" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:T ApDetails_SpeakSignalWhileScanning}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding SpeakSignal}" />
            </Grid>

            <!-- Signal graph -->
            <Label Text="{loc:T ApDetails_SIGNALHISTORY}" FontSize="12" FontAttributes="Bold" TextColor="#1565C0" />
            <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" Padding="4" HeightRequest="180">
                <GraphicsView x:Name="GraphView" />
            </Border>
            <Label Text="{Binding HistoryStatus}" FontSize="11" TextColor="Gray" />

            <!-- Details -->
            <Label Text="{loc:T ApDetails_DETAILS}" FontSize="12" FontAttributes="Bold" TextColor="#1565C0" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="120,*" RowSpacing="6" ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Text="{loc:T Opt_SSID}" TextColor="Gray" />
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Ap.Ssid}" />

                <Label Grid.Row="1" Grid.Column="0" Text="{loc:T Opt_BSSID}" TextColor="Gray" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Ap.Bssid}" />

                <Label Grid.Row="2" Grid.Column="0" Text="{loc:T Opt_Manufacturer}" TextColor="Gray" />
                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Ap.Manufacturer}" />

                <Label Grid.Row="3" Grid.Column="0" Text="{loc:T Opt_Signal}" TextColor="Gray" />
                <Label Grid.Row="3" Grid.Column="1" Text="{Binding Ap.Signal, StringFormat='{0}%'}" />

                <Label Grid.Row="4" Grid.Column="0" Text="{loc:T Channels_Rssi}" TextColor="Gray" />
                <Label Grid.Row="4" Grid.Column="1" Text="{Binding Ap.Rssi, StringFormat={loc:T ApDetails_0DBm}}" />

                <Label Grid.Row="5" Grid.Column="0" Text="{loc:T Opt_Channel}" TextColor="Gray" />
                <Label Grid.Row="5" Grid.Column="1">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Ap.Channel}" />
                            <Span Text="{Binding Ap.FrequencyMhz, Converter={StaticResource FreqToBand}, StringFormat='  ({0})'}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label Grid.Row="6" Grid.Column="0" Text="{loc:T ApDetails_Radio}" TextColor="Gray" />
                <Label Grid.Row="6" Grid.Column="1" Text="{Binding Ap.RadioType}" />

                <Label Grid.Row="7" Grid.Column="0" Text="{loc:T Opt_Security}" TextColor="Gray" />
                <Label Grid.Row="7" Grid.Column="1">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Ap.AuthText}" />
                            <Span Text="{Binding Ap.EncryptionText, StringFormat=' / {0}'}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label Grid.Row="8" Grid.Column="0" Text="{loc:T ApDetails_FirstActive}" TextColor="Gray" />
                <Label Grid.Row="8" Grid.Column="1" Text="{Binding Ap.FirstSeenText}" />

                <Label Grid.Row="9" Grid.Column="0" Text="{loc:T ApDetails_LastActive}" TextColor="Gray" />
                <Label Grid.Row="9" Grid.Column="1" Text="{Binding Ap.LastSeenText}" />

                <Label Grid.Row="10" Grid.Column="0" Text="{loc:T Settings_GPS}" TextColor="Gray" />
                <Label Grid.Row="10" Grid.Column="1" Text="{Binding Ap.GpsText}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
