<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:VistumblerMAUI.Localization"
             xmlns:vm="clr-namespace:VistumblerMAUI.ViewModels"
             x:DataType="vm:SurveyViewModel"
             x:Class="VistumblerMAUI.Views.SurveyPage"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0">
            <!-- Which network the colours show, and whether to fill in between the spots -->
            <Grid ColumnDefinitions="*,Auto,Auto" Padding="12,4" ColumnSpacing="6">
                <Picker Grid.Column="0" Title="{loc:T Survey_Network}" FontSize="13"
                        ItemsSource="{Binding Networks}"
                        SelectedItem="{Binding SelectedNetwork}" />
                <Label Grid.Column="1" Text="{loc:T Survey_Heatmap}" FontSize="12" VerticalOptions="Center" />
                <Switch Grid.Column="2" IsToggled="{Binding ShowHeatmap}" VerticalOptions="Center" />
            </Grid>

            <!-- "All APs heard here now": the latest scan, which is what a spot tapped now records -->
            <VerticalStackLayout IsVisible="{Binding ShowHeardHere}" Padding="0,0,0,4">
                <!-- Tap the header to fold the list away (one line) or open it again -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Padding="12,0,12,4">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleHeardHereCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" Text="▾" FontSize="13" TextColor="Gray" VerticalOptions="Start">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HeardHereExpanded}" Value="False">
                                <Setter Property="Text" Value="▸" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Grid.Column="1" Text="{Binding HeardHere.Count, StringFormat={loc:T Survey_HeardHereHint}}"
                           FontSize="11" TextColor="Gray">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HeardHereExpanded}" Value="False">
                                <Setter Property="MaxLines" Value="1" />
                                <Setter Property="LineBreakMode" Value="TailTruncation" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>
                <CollectionView ItemsSource="{Binding HeardHere}" HeightRequest="180" SelectionMode="None"
                                IsVisible="{Binding HeardHereExpanded}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:HeardAp">
                            <Grid ColumnDefinitions="*,Auto" Padding="12,3" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SurveyViewModel}}, Path=FollowApCommand, x:DataType=vm:SurveyViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="0">
                                    <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label FontSize="10" TextColor="Gray" LineBreakMode="TailTruncation">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Bssid}" />
                                                <Span Text="{Binding Detail, Converter={StaticResource Separated}}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding Rssi, StringFormat={loc:T ApDetails_0DBm}}"
                                       FontSize="13" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- The plan: tap to measure, pinch to zoom, drag to move -->
        <GraphicsView Grid.Row="1" x:Name="Canvas" />

        <VerticalStackLayout Grid.Row="1" HorizontalOptions="End" VerticalOptions="Start" Margin="8" Spacing="6">
            <Button Text="+" Clicked="OnZoomIn" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="20" />
            <Button Text="−" Clicked="OnZoomOut" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="20" />
            <Button Text="⤢" Clicked="OnFit" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="18" />
        </VerticalStackLayout>

        <!-- The Survey menu, opening upward from its button below. A tap anywhere else on the plan closes it
             (and isn't taken as a measurement). -->
        <BoxView Grid.Row="1" Color="Transparent" IsVisible="{Binding IsMenuOpen}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMenuCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border Grid.Row="1" IsVisible="{Binding IsMenuOpen}"
                HorizontalOptions="Start" VerticalOptions="End" Margin="12,0,12,4" Padding="0,6"
                StrokeShape="RoundRectangle 10" Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#444444}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2B2B2B}">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2" />
            </Border.Shadow>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding MenuItems}" MinimumWidthRequest="200">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SurveyMenuItem">
                        <Label Text="{Binding Label}" FontSize="14" Padding="16,10">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Command}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout Grid.Row="2" Padding="12,6" Spacing="6">
            <Label Text="{Binding Status}" FontSize="13" />
            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <!-- First, so new surveys, opening one and the floor plan are easy to find -->
                <Button Text="{loc:T Survey_Survey}" Command="{Binding ToggleMenuCommand}" Margin="0,0,6,6" />
                <Button Text="{loc:T Survey_StartScanning}" Command="{Binding StartScanningCommand}" Margin="0,0,6,6"
                        IsVisible="{Binding IsScanning, Converter={StaticResource InvertBool}}" />
                <Button Text="{loc:T Common_Cancel}" Command="{Binding CancelMarkCommand}" Margin="0,0,6,6"
                        IsVisible="{Binding IsWaiting}" />
                <Button Text="{loc:T Survey_UndoLast}" Command="{Binding UndoMarkCommand}" Margin="0,0,6,6" />
                <Button Text="{loc:T Survey_SaveImage}" Clicked="OnSaveImage" Margin="0,0,6,6" />
            </FlexLayout>
            <!-- Colour key: WifiDB's signal-map colours -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Label Grid.Column="0" Text="{loc:T Survey_100DBm}" FontSize="10" TextColor="Gray" />
                <BoxView Grid.Column="1" HeightRequest="8" VerticalOptions="Center">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#E42F00" Offset="0" />
                            <GradientStop Color="#FF0000" Offset="0.2" />
                            <GradientStop Color="#FF9200" Offset="0.43" />
                            <GradientStop Color="#FFEC00" Offset="0.6" />
                            <GradientStop Color="#80FF00" Offset="0.8" />
                            <GradientStop Color="#0D7600" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <Label Grid.Column="2" Text="{loc:T Survey_40DBm}" FontSize="10" TextColor="Gray" />
            </Grid>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
