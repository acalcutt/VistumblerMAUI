<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VistumblerMAUI.ViewModels"
             x:DataType="vm:SurveyViewModel"
             x:Class="VistumblerMAUI.Views.SurveyPage"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Survey ▾" Command="{Binding SurveyMenuCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Which network the colours show, and whether to fill in between the spots -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Padding="12,4" ColumnSpacing="6">
            <Picker Grid.Column="0" Title="Network" FontSize="13"
                    ItemsSource="{Binding Networks}"
                    SelectedItem="{Binding SelectedNetwork}" />
            <Label Grid.Column="1" Text="Heatmap" FontSize="12" VerticalOptions="Center" />
            <Switch Grid.Column="2" IsToggled="{Binding ShowHeatmap}" VerticalOptions="Center" />
        </Grid>

        <!-- The plan: tap to measure, pinch to zoom, drag to move -->
        <GraphicsView Grid.Row="1" x:Name="Canvas" />

        <VerticalStackLayout Grid.Row="1" HorizontalOptions="End" VerticalOptions="Start" Margin="8" Spacing="6">
            <Button Text="+" Clicked="OnZoomIn" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="20" />
            <Button Text="−" Clicked="OnZoomOut" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="20" />
            <Button Text="⤢" Clicked="OnFit" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="18" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Padding="12,6" Spacing="6">
            <Label Text="{Binding Status}" FontSize="13" />
            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <Button Text="Start scanning" Command="{Binding StartScanningCommand}" Margin="0,0,6,6"
                        IsVisible="{Binding IsScanning, Converter={StaticResource InvertBool}}" />
                <Button Text="Cancel" Command="{Binding CancelMarkCommand}" Margin="0,0,6,6"
                        IsVisible="{Binding IsWaiting}" />
                <Button Text="Undo last" Command="{Binding UndoMarkCommand}" Margin="0,0,6,6" />
                <Button Text="Save image" Clicked="OnSaveImage" Margin="0,0,6,6" />
            </FlexLayout>
            <!-- Colour key: WifiDB's signal-map colours -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Label Grid.Column="0" Text="-100 dBm" FontSize="10" TextColor="Gray" />
                <BoxView Grid.Column="1" HeightRequest="8" VerticalOptions="Center">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#E42F00" Offset="0" />
                            <GradientStop Color="#FF0000" Offset="0.2" />
                            <GradientStop Color="#FF9200" Offset="0.43" />
                            <GradientStop Color="#FFEC00" Offset="0.6" />
                            <GradientStop Color="#80FF00" Offset="0.8" />
                            <GradientStop Color="#0D7600" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <Label Grid.Column="2" Text="-40 dBm" FontSize="10" TextColor="Gray" />
            </Grid>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
