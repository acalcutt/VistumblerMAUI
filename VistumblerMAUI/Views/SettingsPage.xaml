<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VistumblerMAUI.ViewModels"
             xmlns:controls="clr-namespace:VistumblerMAUI.Controls"
             x:DataType="vm:SettingsViewModel"
             x:Class="VistumblerMAUI.Views.SettingsPage"
             Title="Settings">

    <Grid RowDefinitions="Auto,*">
        <controls:ScanControlBar x:Name="ScanBar" Grid.Row="0" />

        <ScrollView Grid.Row="1">
        <VerticalStackLayout Spacing="0" Padding="0,8">

            <!-- Scanning -->
            <Label Text="SCANNING" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="*,Auto" Padding="16,12" ColumnSpacing="12">
                <Label Grid.Column="0" Text="Scan interval (ms)" VerticalOptions="Center" />
                <Entry Grid.Column="1" Text="{Binding ScanIntervalMs}" Keyboard="Numeric" WidthRequest="80" />
            </Grid>
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,0" />

            <!-- Map -->
            <Label Text="MAP" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="12">
                <Label Grid.Column="0" Text="Basemap style" VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding MapStyleOptions}"
                        SelectedItem="{Binding SelectedMapStyle}" />
            </Grid>
            <Entry Margin="16,0,16,8"
                   IsVisible="{Binding IsCustomMapStyle}"
                   Text="{Binding CustomMapStyleUrl}"
                   Placeholder="https://…/style.json"
                   Keyboard="Url" />
            <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="12">
                <Label Grid.Column="0" Text="GPS follow zoom" VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding FollowZoomOptions}"
                        SelectedItem="{Binding SelectedFollowZoom}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" Padding="16,0,16,8" ColumnSpacing="12"
                  IsVisible="{Binding IsManualFollowZoom}">
                <Label Grid.Column="0" Text="Zoom level (1–22)" VerticalOptions="Center" />
                <Entry Grid.Column="1"
                       Text="{Binding ManualFollowZoom}"
                       Keyboard="Numeric"
                       WidthRequest="80"
                       HorizontalOptions="Start" />
            </Grid>
            <Label Margin="16,0,16,8" FontSize="12" TextColor="Gray"
                   Text="Zoom applied when the map's GPS button enters Follow mode. Auto picks a level where the fix's accuracy circle is visible; pinch-zooming afterwards sticks until Follow is re-entered." />
            <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,8" ColumnSpacing="12">
                <Label Grid.Column="0" Text="AP point size" VerticalOptions="Center" />
                <Slider Grid.Column="1" Minimum="0.5" Maximum="3" Value="{Binding MapPointScale}" />
                <Label Grid.Column="2" Text="{Binding MapPointScaleText}" WidthRequest="48"
                       HorizontalTextAlignment="End" VerticalOptions="Center" />
            </Grid>
            <Label Margin="16,0,16,8" FontSize="12" TextColor="Gray"
                   Text="Size of the access point dots on the map, live scan and WifiDB history alike." />
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,0" />

            <!-- Save & Clear -->
            <Label Text="SAVE &amp; CLEAR" Style="{StaticResource SectionHeader}" />
            <Label Margin="16,0,16,4" FontSize="12" TextColor="Gray"
                   Text="Save &amp; Clear (menu) saves the access points to a file here, then clears the list while scanning carries on. Auto Save And Clear does it for you." />
            <Grid ColumnDefinitions="*,Auto" Margin="16,4" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{Binding SaveFolder}" LineBreakMode="HeadTruncation" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Browse…" Command="{Binding BrowseSaveFolderCommand}"
                        Padding="12,0" HeightRequest="36" />
            </Grid>
            <Button Text="Use default folder" Command="{Binding UseDefaultSaveFolderCommand}"
                    IsVisible="{Binding IsCustomSaveFolder}"
                    Margin="16,0" HorizontalOptions="Start" Padding="12,0" HeightRequest="32"
                    BackgroundColor="Transparent" TextColor="Gray" />
            <Label Text="{Binding SaveFolderStatus}"
                   IsVisible="{Binding SaveFolderStatus, Converter={StaticResource IsNotNullOrEmpty}}"
                   FontSize="12" TextColor="Gray" Margin="16,0,16,4" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Padding="16,8" ColumnSpacing="12" RowSpacing="8">
                <Label Grid.Row="0" Grid.Column="0" Text="File name" VerticalOptions="Center" />
                <Entry Grid.Row="0" Grid.Column="1" Text="{Binding SaveFileName}" Placeholder="AutoSave" />
                <Label Grid.Row="1" Grid.Column="0" Text="File type" VerticalOptions="Center" />
                <Picker Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SaveFormatOptions}"
                        SelectedItem="{Binding SelectedSaveFormat}" />
            </Grid>
            <Label Text="{Binding SaveFileNameExample, StringFormat='For example: {0}'}"
                   FontSize="11" TextColor="Gray" Margin="16,0,16,4" />
            <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                <Label Grid.Column="0" Text="Auto Save And Clear" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding AutoSaveAndClear}" />
            </Grid>
            <VerticalStackLayout IsVisible="{Binding AutoSaveAndClear}" Padding="16,0,16,8" Spacing="8">
                <Picker ItemsSource="{Binding AutoSaveTriggerOptions}" SelectedItem="{Binding SelectedAutoSaveTrigger}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsAutoSaveByTime, Converter={StaticResource InvertBool}}">
                    <Label Grid.Column="0" Text="Save once the list has this many APs" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding AutoSaveApCount}" Keyboard="Numeric" WidthRequest="80" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsAutoSaveByTime}">
                    <Label Grid.Column="0" Text="Save every this many minutes of scanning" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding AutoSaveMinutes}" Keyboard="Numeric" WidthRequest="80" />
                </Grid>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                <Label Grid.Column="0" Text="Upload each save to WifiDB" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding UploadSavesToWifiDb}" />
            </Grid>
            <Label Text="Uses the WifiDB account below. The file is kept either way."
                   FontSize="11" TextColor="Gray" Margin="16,0,16,8" />
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,0" />

            <!-- Map AP colors -->
            <Label Text="MAP AP COLORS" Style="{StaticResource SectionHeader}" />
            <Label Margin="16,0,16,4" FontSize="12" TextColor="Gray"
                   Text="Circle colors per age bucket, by security type (hex RRGGBB). The live scan's active APs are brightest; dead and older buckets darken with age." />
            <Grid ColumnDefinitions="110,*,*,*" Padding="16,0,16,2" ColumnSpacing="6">
                <Label Grid.Column="0" Text="Bucket"  FontSize="11" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="Open"    FontSize="11" FontAttributes="Bold" />
                <Label Grid.Column="2" Text="WEP"     FontSize="11" FontAttributes="Bold" />
                <Label Grid.Column="3" Text="Secure"  FontSize="11" FontAttributes="Bold" />
            </Grid>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding MapBucketColors}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:MapBucketColorRow">
                        <Grid ColumnDefinitions="110,*,*,*" Padding="16,2" ColumnSpacing="6">
                            <Label Grid.Column="0" Text="{Binding DisplayName}" FontSize="12" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                <Entry Text="{Binding OpenHex}" WidthRequest="66" FontSize="12" MaxLength="6" />
                                <BoxView WidthRequest="14" HeightRequest="18" VerticalOptions="Center"
                                         Color="{Binding OpenHex, Converter={StaticResource HexToColor}}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                <Entry Text="{Binding WepHex}" WidthRequest="66" FontSize="12" MaxLength="6" />
                                <BoxView WidthRequest="14" HeightRequest="18" VerticalOptions="Center"
                                         Color="{Binding WepHex, Converter={StaticResource HexToColor}}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="3" Spacing="4">
                                <Entry Text="{Binding SecureHex}" WidthRequest="66" FontSize="12" MaxLength="6" />
                                <BoxView WidthRequest="14" HeightRequest="18" VerticalOptions="Center"
                                         Color="{Binding SecureHex, Converter={StaticResource HexToColor}}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,8,16,0" />

            <!-- Notifications -->
            <Label Text="NOTIFICATIONS" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                <Label Grid.Column="0" Text="Sound alerts" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding SoundEnabled}" />
            </Grid>
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,0" />

            <!-- GPS -->
            <Label Text="GPS" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="Auto,*" Padding="16,8" ColumnSpacing="12">
                <Label Grid.Column="0" Text="GPS source" VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding GpsSourceOptions}"
                        SelectedItem="{Binding SelectedGpsSource}" />
            </Grid>
            <!-- Serial (NMEA) settings, shown only when the serial source is selected -->
            <VerticalStackLayout IsVisible="{Binding IsSerialGps}" Padding="16,0,16,8" Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="COM port" VerticalOptions="Center" />
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding ComPorts}"
                            SelectedItem="{Binding SelectedComPort}" />
                    <Button Grid.Column="2" Text="Refresh"
                            Command="{Binding RefreshComPortsCommand}"
                            Padding="10,4" FontSize="12" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="Baud rate" VerticalOptions="Center" />
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding BaudRateOptions}"
                            SelectedItem="{Binding SelectedBaudRate}" />
                </Grid>
                <Label Text="Serial NMEA is Windows-only. Choose the COM port your GPS receiver uses."
                       FontSize="11" TextColor="Gray" />
            </VerticalStackLayout>
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,0" />

            <!-- WifiDB -->
            <Label Text="WIFIDB" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="Auto,*" Padding="16,8" ColumnSpacing="12" RowSpacing="8"
                  RowDefinitions="Auto,Auto,Auto,Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Base URL" VerticalOptions="Center" />
                <Entry Grid.Row="0" Grid.Column="1" Text="{Binding WifiDbUrl}"
                       Placeholder="https://wifidb.net/" Keyboard="Url" />

                <Label Grid.Row="1" Grid.Column="0" Text="Username" VerticalOptions="Center" />
                <Entry Grid.Row="1" Grid.Column="1" Text="{Binding WifiDbUser}" Placeholder="username" />

                <Label Grid.Row="2" Grid.Column="0" Text="API key" VerticalOptions="Center" />
                <Entry Grid.Row="2" Grid.Column="1" Text="{Binding WifiDbApiKey}"
                       Placeholder="API key" IsPassword="True" />

                <Label Grid.Row="3" Grid.Column="0" Text="Data URL" VerticalOptions="Center" />
                <Entry Grid.Row="3" Grid.Column="1" Text="{Binding WifiDbDataUrl}"
                       Placeholder="https://data.wifidb.net" Keyboard="Url" />
            </Grid>
            <Label Text="Data URL serves the map history archives and the feed listing them — a different host from the site above."
                   FontSize="11" TextColor="Gray" Margin="16,0" />

            <Button Text="Register with QR code"
                    Command="{Binding ScanWifiDbQrCommand}"
                    Margin="16,4" HorizontalOptions="Fill" />
            <Button Text="Register with link…"
                    Command="{Binding RedeemWifiDbLinkCommand}"
                    Margin="16,0,16,4" HorizontalOptions="Fill"
                    BackgroundColor="Transparent" TextColor="#1565C0" />
            <Label Text="{Binding WifiDbStatus}"
                   IsVisible="{Binding WifiDbStatus, Converter={StaticResource IsNotNullOrEmpty}}"
                   FontSize="12" TextColor="Gray" Margin="16,0,16,4" />
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,4" />

            <!-- Data -->
            <Label Text="DATA" Style="{StaticResource SectionHeader}" />
            <Button Text="Import…"
                    Command="{Binding GoToImportCommand}"
                    Margin="16,8" HorizontalOptions="Fill" />
            <Button Text="Export…"
                    Command="{Binding GoToExportCommand}"
                    Margin="16,4" HorizontalOptions="Fill" />

            <!-- Updates -->
            <Label Text="UPDATES" Style="{StaticResource SectionHeader}" />
            <VerticalStackLayout IsVisible="{Binding UpdatesSupported}">
                <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                    <Label Grid.Column="0" Text="Check for updates at startup" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding AutoCheckForUpdates}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                    <Label Grid.Column="0" Text="Include pre-releases" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding IncludePrereleaseUpdates}" />
                </Grid>
                <Label Text="Pre-releases (e.g. 0.5.0-rc.1) get new features first but may be less stable."
                       FontSize="11" TextColor="Gray" Margin="16,0,16,4" />
                <Button Text="Check for Updates"
                        Command="{Binding CheckForUpdatesCommand}"
                        Margin="16,8" HorizontalOptions="Fill" />
            </VerticalStackLayout>
            <!-- Where updates aren't offered (the Google Play build, iOS), say why instead -->
            <Label Text="{Binding UpdatesUnsupportedReason}" IsVisible="{Binding UpdatesUnsupported}"
                   Padding="16,8" />
            <Label Text="{Binding VersionText}" FontSize="12" TextColor="Gray" Margin="16,0,16,4" />
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,4" />

            <!-- Advanced -->
            <Label Text="ADVANCED" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                <Label Grid.Column="0" Text="Keep screen on while scanning" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding KeepScreenOn}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                <Label Grid.Column="0" Text="Debug logging" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding DebugLogging}" />
            </Grid>
            <Label Text="Writes GPS fixes and map layer refreshes to the debug log (adb logcat) for troubleshooting."
                   FontSize="11" TextColor="Gray" Margin="16,0,16,8" />

        </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
