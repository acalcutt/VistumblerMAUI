<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VistumblerMAUI.ViewModels"
             xmlns:controls="clr-namespace:VistumblerMAUI.Controls"
             xmlns:loc="clr-namespace:VistumblerMAUI.Localization"
             x:DataType="vm:SettingsViewModel"
             x:Class="VistumblerMAUI.Views.SettingsPage"
             Title="{loc:T Tab_Settings}">

    <Grid RowDefinitions="Auto,*">
        <controls:ScanControlBar x:Name="ScanBar" Grid.Row="0" />

        <ScrollView Grid.Row="1">
        <VerticalStackLayout Spacing="0" Padding="0,8">

            <!-- Language (SettingsViewModel.Language.cs) -->
            <Grid ColumnDefinitions="Auto,*" Padding="16,8" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{loc:T Settings_Language}" VerticalOptions="Center" />
                <Picker Grid.Column="1" ItemsSource="{Binding LanguageNames}" SelectedItem="{Binding SelectedLanguageName}" />
            </Grid>
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,0" />

            <!-- Scanning -->
            <Label Text="{loc:T Settings_SCANNING}" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="*,Auto" Padding="16,12" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{loc:T Settings_ScanIntervalMs}" VerticalOptions="Center" />
                <Entry Grid.Column="1" Text="{Binding ScanIntervalMs}" Keyboard="Numeric" WidthRequest="80" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Padding="16,4">
                <Label Grid.Column="0" Text="{loc:T Settings_StartScanningWhenTheApp}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ScanOnLaunch}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Padding="16,4">
                <Label Grid.Column="0" Text="{loc:T Settings_TurnOnGPSWhenThe}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding GpsOnLaunch}" />
            </Grid>
            <!-- Android: cell towers and Bluetooth devices, kept apart from the APs (the type picker on the Scan page) -->
            <Grid ColumnDefinitions="*,Auto" Padding="16,4" IsVisible="{Binding HasCellScanning}">
                <Label Grid.Column="0" Text="{loc:T Settings_AlsoRecordCellTowers}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ScanCells}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Padding="16,4" IsVisible="{Binding HasBluetoothScanning}">
                <Label Grid.Column="0" Text="{loc:T Settings_AlsoRecordBluetoothDevices}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ScanBluetooth}" />
            </Grid>
            <!-- Windows: which Wi-Fi adapter to scan with (the original's Interface menu) -->
            <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,8" ColumnSpacing="8" IsVisible="{Binding HasAdapterChoice}">
                <Label Grid.Column="0" Text="{loc:T Settings_WiFiAdapter}" VerticalOptions="Center" />
                <Picker Grid.Column="1" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" />
                <Button Grid.Column="2" Text="{loc:T Settings_Refresh}" Command="{Binding RefreshAdaptersCommand}"
                        Padding="10,4" FontSize="12" />
            </Grid>
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,0" />

            <!-- Map -->
            <Label Text="{loc:T Settings_MAP}" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{loc:T Settings_BasemapStyle}" VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding MapStyleOptions}"
                        SelectedItem="{Binding SelectedMapStyle}" />
            </Grid>
            <Entry Margin="16,0,16,8"
                   IsVisible="{Binding IsCustomMapStyle}"
                   Text="{Binding CustomMapStyleUrl}"
                   Placeholder="https://…/style.json"
                   Keyboard="Url" />
            <Grid ColumnDefinitions="Auto,*" Padding="16,12" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{loc:T Settings_GPSFollowZoom}" VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding FollowZoomOptions}" ItemDisplayBinding="{Binding ., Converter={StaticResource LocValue}, x:DataType=x:String}"
                        SelectedItem="{Binding SelectedFollowZoom}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" Padding="16,0,16,8" ColumnSpacing="12"
                  IsVisible="{Binding IsManualFollowZoom}">
                <Label Grid.Column="0" Text="{loc:T Settings_ZoomLevel122}" VerticalOptions="Center" />
                <Entry Grid.Column="1"
                       Text="{Binding ManualFollowZoom}"
                       Keyboard="Numeric"
                       WidthRequest="80"
                       HorizontalOptions="Start" />
            </Grid>
            <Label Margin="16,0,16,8" FontSize="12" TextColor="Gray"
                   Text="{loc:T Settings_ZoomAppliedWhenTheMap}" />
            <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,8" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{loc:T Settings_APPointSize}" VerticalOptions="Center" />
                <Slider Grid.Column="1" Minimum="0.5" Maximum="3" Value="{Binding MapPointScale}" />
                <Label Grid.Column="2" Text="{Binding MapPointScaleText}" WidthRequest="48"
                       HorizontalTextAlignment="End" VerticalOptions="Center" />
            </Grid>
            <Label Margin="16,0,16,8" FontSize="12" TextColor="Gray"
                   Text="{loc:T Settings_SizeOfTheAccessPoint}" />
            <Button Text="{loc:T Settings_MapAPColors}" Command="{Binding OpenMapColorsCommand}"
                    Margin="16,4" HorizontalOptions="Fill" />
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,0" />

            <!-- GPS -->
            <Label Text="{loc:T Settings_GPS}" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="Auto,*" Padding="16,8" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{loc:T Settings_GPSSource}" VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding GpsSourceOptions}" ItemDisplayBinding="{Binding ., Converter={StaticResource LocValue}, x:DataType=x:String}"
                        SelectedItem="{Binding SelectedGpsSource}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Padding="16,4">
                <Label Grid.Column="0" Text="{loc:T Settings_RecordTheGPSTrackEven}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding SaveGpsWithoutAps}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" Padding="16,8" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{loc:T Settings_CoordinateFormat}" VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding GpsFormatOptions}"
                        SelectedItem="{Binding SelectedGpsFormat}" />
            </Grid>
            <!-- Serial (NMEA) settings, shown only when the serial source is selected -->
            <VerticalStackLayout IsVisible="{Binding IsSerialGps}" Padding="16,0,16,8" Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{loc:T Settings_COMPort}" VerticalOptions="Center" />
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding ComPorts}"
                            SelectedItem="{Binding SelectedComPort}" />
                    <Button Grid.Column="2" Text="{loc:T Settings_Refresh}"
                            Command="{Binding RefreshComPortsCommand}"
                            Padding="10,4" FontSize="12" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="{loc:T Settings_BaudRate}" VerticalOptions="Center" />
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding BaudRateOptions}"
                            SelectedItem="{Binding SelectedBaudRate}" />
                </Grid>
                <Label Text="{loc:T Settings_ChooseTheCOMPortYour}"
                       FontSize="11" TextColor="Gray" />
            </VerticalStackLayout>
            <!-- Options for external NMEA receivers (COM port, Bluetooth, USB), from the original Vistumbler -->
            <VerticalStackLayout IsVisible="{Binding IsExternalGps}" Padding="0,0,0,4">
                <Grid ColumnDefinitions="*,Auto" Padding="16,4">
                    <Label Grid.Column="0" Text="{loc:T Settings_ReconnectTheReceiverWhenNo}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding ReconnectGpsWhenNoData}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Padding="16,4">
                    <Label Grid.Column="0" Text="{loc:T Settings_ResetGPSPositionWhenNo}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding ResetGpsPositionWhenNoFix}" />
                </Grid>
                <Label Text="{loc:T Settings_TurnOffTheReconnectFor}"
                       FontSize="11" TextColor="Gray" Margin="16,0,16,4" />
            </VerticalStackLayout>
            <!-- USB (NMEA) receiver, Android -->
            <VerticalStackLayout IsVisible="{Binding IsUsbGps}" Padding="16,0,16,8" Spacing="8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="{loc:T Settings_BaudRate}" VerticalOptions="Center" />
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding BaudRateOptions}"
                            SelectedItem="{Binding SelectedUsbBaudRate}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{Binding UsbDevicesText}" FontSize="12" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{loc:T Settings_Refresh}"
                            Command="{Binding RefreshUsbDevicesCommand}"
                            Padding="10,4" FontSize="12" />
                </Grid>
                <Label Text="{loc:T Settings_PlugTheReceiverInWith}"
                       FontSize="11" TextColor="Gray" />
            </VerticalStackLayout>
            <!-- Bluetooth (NMEA) receiver, Android -->
            <VerticalStackLayout IsVisible="{Binding IsBluetoothGps}" Padding="16,0,16,8" Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{loc:T Settings_Receiver}" VerticalOptions="Center" />
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding BluetoothDevices}"
                            SelectedItem="{Binding SelectedBluetoothDevice}" />
                    <Button Grid.Column="2" Text="{loc:T Settings_Refresh}"
                            Command="{Binding RefreshBluetoothDevicesCommand}"
                            Padding="10,4" FontSize="12" />
                </Grid>
                <Label Text="{Binding BluetoothStatus}"
                       IsVisible="{Binding BluetoothStatus, Converter={StaticResource IsNotNullOrEmpty}}"
                       FontSize="12" TextColor="Gray" />
                <Label Text="{loc:T Settings_PairTheReceiverInAndroid}"
                       FontSize="11" TextColor="Gray" />
            </VerticalStackLayout>
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,0" />

            <!-- WifiDB -->
            <Label Text="{loc:T Settings_WIFIDB}" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="Auto,*" Padding="16,8" ColumnSpacing="12" RowSpacing="8"
                  RowDefinitions="Auto,Auto,Auto,Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="{loc:T Settings_BaseURL}" VerticalOptions="Center" />
                <Entry Grid.Row="0" Grid.Column="1" Text="{Binding WifiDbUrl}"
                       Placeholder="https://wifidb.net/" Keyboard="Url" />

                <Label Grid.Row="1" Grid.Column="0" Text="{loc:T Settings_Username}" VerticalOptions="Center" />
                <Entry Grid.Row="1" Grid.Column="1" Text="{Binding WifiDbUser}" Placeholder="{loc:T Settings_Username2}" />

                <Label Grid.Row="2" Grid.Column="0" Text="{loc:T Settings_APIKey}" VerticalOptions="Center" />
                <Entry Grid.Row="2" Grid.Column="1" Text="{Binding WifiDbApiKey}"
                       Placeholder="{loc:T Settings_APIKey}" IsPassword="True" />

                <Label Grid.Row="3" Grid.Column="0" Text="{loc:T Settings_DataURL}" VerticalOptions="Center" />
                <Entry Grid.Row="3" Grid.Column="1" Text="{Binding WifiDbDataUrl}"
                       Placeholder="https://data.wifidb.net" Keyboard="Url" />
            </Grid>
            <Label Text="{loc:T Settings_DataURLServesTheMap}"
                   FontSize="11" TextColor="Gray" Margin="16,0" />

            <Button Text="{loc:T Settings_RegisterWithQRCode}"
                    Command="{Binding ScanWifiDbQrCommand}"
                    Margin="16,4" HorizontalOptions="Fill" />
            <Button Text="{loc:T Settings_RegisterWithLink}"
                    Command="{Binding RedeemWifiDbLinkCommand}"
                    Margin="16,0,16,4" HorizontalOptions="Fill"
                    BackgroundColor="Transparent" TextColor="#1565C0" />
            <Label Text="{Binding WifiDbStatus}"
                   IsVisible="{Binding WifiDbStatus, Converter={StaticResource IsNotNullOrEmpty}}"
                   FontSize="12" TextColor="Gray" Margin="16,0,16,4" />
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,4" />

            <!-- WiGLE: optional, secondary to WifiDB, off by default (SettingsViewModel.Wigle.cs) -->
            <Label Text="{loc:T Settings_WIGLEOPTIONAL}" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="*,Auto" Padding="16,4" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="{loc:T Settings_AlsoUploadToWiGLE}" />
                    <Label Text="{loc:T Settings_OptionalAlongsideWifiDBSendsWi}"
                           FontSize="11" TextColor="Gray" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" IsToggled="{Binding WigleEnabled}" />
            </Grid>
            <VerticalStackLayout IsVisible="{Binding WigleEnabled}" Spacing="4">
                <Label Text="{Binding WigleTerms}" FontSize="12" TextColor="#795548" Margin="16,4,16,0" />
                <Button Text="{loc:T Settings_ReadWiGLESTermsOf}" Command="{Binding OpenWigleTermsCommand}"
                        Margin="16,0" HorizontalOptions="Start" Padding="0" HeightRequest="32"
                        BackgroundColor="Transparent" TextColor="#1565C0" FontSize="13" />
                <Grid ColumnDefinitions="Auto,*" Padding="16,4" ColumnSpacing="12" RowSpacing="8" RowDefinitions="Auto,Auto">
                    <Label Grid.Row="0" Grid.Column="0" Text="{loc:T Settings_APIName}" VerticalOptions="Center" />
                    <Entry Grid.Row="0" Grid.Column="1" Text="{Binding WigleApiName}" Placeholder="{loc:T Settings_AID}" />
                    <Label Grid.Row="1" Grid.Column="0" Text="{loc:T Settings_APIToken}" VerticalOptions="Center" />
                    <Entry Grid.Row="1" Grid.Column="1" Text="{Binding WigleApiToken}" Placeholder="{loc:T Settings_APIToken}" IsPassword="True" />
                </Grid>
                <Button Text="{loc:T Settings_GetMyAPINameAnd}" Command="{Binding OpenWigleAccountCommand}"
                        Margin="16,0" HorizontalOptions="Start" Padding="0" HeightRequest="32"
                        BackgroundColor="Transparent" TextColor="#1565C0" FontSize="13" />
                <Grid ColumnDefinitions="*,Auto" Padding="16,4" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{loc:T Settings_UploadEachSaveClearTo}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding WigleUploadEachSave}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Padding="16,4" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="{loc:T Settings_DonateForCommercialUse}" />
                        <Label Text="{loc:T Settings_LetsWiGLEAlsoLicenseYour}"
                               FontSize="11" TextColor="Gray" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding WigleDonate}" />
                </Grid>
                <VerticalStackLayout IsVisible="{Binding HasPendingWigle}" Margin="16,4" Spacing="4">
                    <Label Text="{Binding PendingWigleText}" FontSize="12" TextColor="#C62828" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="{loc:T Settings_RetryNow}" Command="{Binding RetryWigleCommand}" Padding="12,0" HeightRequest="36" />
                        <Button Text="{loc:T Bar_Stop}" Command="{Binding ClearWigleCommand}" Padding="12,0" HeightRequest="36"
                                BackgroundColor="Transparent" TextColor="Gray" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,4" />

            <!-- Save & Clear -->
            <Label Text="{loc:T Settings_SAVECLEAR}" Style="{StaticResource SectionHeader}" />
            <Label Margin="16,0,16,4" FontSize="12" TextColor="Gray"
                   Text="{loc:T Settings_SaveClearMenuSavesThe}" />
            <Grid ColumnDefinitions="*,Auto" Margin="16,4" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{Binding SaveFolder}" LineBreakMode="HeadTruncation" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="{loc:T Settings_Browse}" Command="{Binding BrowseSaveFolderCommand}"
                        Padding="12,0" HeightRequest="36" />
            </Grid>
            <Button Text="{loc:T Settings_UseDefaultFolder}" Command="{Binding UseDefaultSaveFolderCommand}"
                    IsVisible="{Binding IsCustomSaveFolder}"
                    Margin="16,0" HorizontalOptions="Start" Padding="12,0" HeightRequest="32"
                    BackgroundColor="Transparent" TextColor="Gray" />
            <Label Text="{Binding SaveFolderStatus}"
                   IsVisible="{Binding SaveFolderStatus, Converter={StaticResource IsNotNullOrEmpty}}"
                   FontSize="12" TextColor="Gray" Margin="16,0,16,4" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Padding="16,8" ColumnSpacing="12" RowSpacing="8">
                <Label Grid.Row="0" Grid.Column="0" Text="{loc:T Settings_FileName}" VerticalOptions="Center" />
                <Entry Grid.Row="0" Grid.Column="1" Text="{Binding SaveFileName}" Placeholder="{loc:T Settings_AutoSave}" />
                <Label Grid.Row="1" Grid.Column="0" Text="{loc:T Settings_FileType}" VerticalOptions="Center" />
                <Picker Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SaveFormatOptions}" ItemDisplayBinding="{Binding ., Converter={StaticResource LocValue}, x:DataType=x:String}"
                        SelectedItem="{Binding SelectedSaveFormat}" />
            </Grid>
            <Label Text="{Binding SaveFileNameExample, StringFormat={loc:T Settings_ForExample0}}"
                   FontSize="11" TextColor="Gray" Margin="16,0,16,4" />
            <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                <Label Grid.Column="0" Text="{loc:T Settings_AutoSaveAndClear}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding AutoSaveAndClear}" />
            </Grid>
            <VerticalStackLayout IsVisible="{Binding AutoSaveAndClear}" Padding="16,0,16,8" Spacing="8">
                <Picker ItemsSource="{Binding AutoSaveTriggerOptions}" ItemDisplayBinding="{Binding ., Converter={StaticResource LocValue}, x:DataType=x:String}" SelectedItem="{Binding SelectedAutoSaveTrigger}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsAutoSaveByTime, Converter={StaticResource InvertBool}}">
                    <Label Grid.Column="0" Text="{loc:T Settings_SaveOnceTheListHas}" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding AutoSaveApCount}" Keyboard="Numeric" WidthRequest="80" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsAutoSaveByTime}">
                    <Label Grid.Column="0" Text="{loc:T Settings_SaveEveryThisManyMinutes}" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding AutoSaveMinutes}" Keyboard="Numeric" WidthRequest="80" />
                </Grid>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                <Label Grid.Column="0" Text="{loc:T Settings_UploadEachSaveToWifiDB}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding UploadSavesToWifiDb}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Padding="16,4" IsVisible="{Binding UploadSavesToWifiDb}">
                <Label Grid.Column="0" Text="{loc:T Settings_DeleteTheSavedFileOnce}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding DeleteSavesAfterUpload}" />
            </Grid>
            <Label Text="{loc:T Settings_UsesTheWifiDBAccountBelow}"
                   FontSize="11" TextColor="Gray" Margin="16,0,16,8" />
            <VerticalStackLayout IsVisible="{Binding HasPendingUploads}" Padding="16,0,16,8" Spacing="4">
                <Label Text="{Binding PendingUploadsText}" FontSize="12" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="{loc:T Settings_RetryNow}" Command="{Binding RetryUploadsCommand}"
                            Padding="12,0" HeightRequest="32" />
                    <Button Text="{loc:T Settings_StopUploading}" Command="{Binding ClearUploadsCommand}"
                            Padding="12,0" HeightRequest="32"
                            BackgroundColor="Transparent" TextColor="Gray" />
                    <ActivityIndicator IsRunning="{Binding IsRetryingUploads}" IsVisible="{Binding IsRetryingUploads}"
                                       HeightRequest="24" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,0" />

            <!-- Sound (the original Vistumbler's sounds) -->
            <Label Text="{loc:T Settings_SOUND}" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                <Label Grid.Column="0" Text="{loc:T Settings_PlayASoundWhenNew}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding SoundEnabled}" />
            </Grid>
            <Picker Margin="16,0,16,4" IsVisible="{Binding SoundEnabled}"
                    ItemsSource="{Binding NewApSoundOptions}" ItemDisplayBinding="{Binding ., Converter={StaticResource LocValue}, x:DataType=x:String}" SelectedItem="{Binding SelectedNewApSound}" />
            <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                <Label Grid.Column="0" Text="{loc:T Settings_PlayASoundWhenThe}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ErrorSound}" />
            </Grid>
            <Label Text="{loc:T Settings_SpeakingAnAPSSignal}"
                   FontSize="12" Margin="16,8,16,0" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Padding="16,8" ColumnSpacing="12" RowSpacing="8">
                <Label Grid.Row="0" Grid.Column="0" Text="{loc:T Settings_Voice}" VerticalOptions="Center" />
                <Picker Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SpeakVoiceOptions}" ItemDisplayBinding="{Binding ., Converter={StaticResource LocValue}, x:DataType=x:String}" SelectedItem="{Binding SelectedSpeakVoice}" />
                <Label Grid.Row="1" Grid.Column="0" Text="{loc:T Settings_Say}" VerticalOptions="Center" />
                <Picker Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SpeakValueOptions}" ItemDisplayBinding="{Binding ., Converter={StaticResource LocValue}, x:DataType=x:String}" SelectedItem="{Binding SelectedSpeakValue}" />
                <Label Grid.Row="2" Grid.Column="0" Text="{loc:T Settings_SpeakEverySeconds}" VerticalOptions="Center" />
                <Entry Grid.Row="2" Grid.Column="1" Text="{Binding SpeakIntervalSeconds}" Keyboard="Numeric"
                       WidthRequest="80" HorizontalOptions="Start" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Padding="16,4,16,8">
                <Label Grid.Column="0" Text="{loc:T Settings_SayTheUnitPercentOr}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding SayPercent}" />
            </Grid>
            <Label Text="{loc:T Settings_TheTonePlaysTheSignal}"
                   FontSize="11" TextColor="Gray" Margin="16,0,16,8" />
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,0" />

            <!-- Data -->
            <Label Text="{loc:T Settings_DATA}" Style="{StaticResource SectionHeader}" />
            <Button Text="{loc:T Menu_Import}"
                    Command="{Binding GoToImportCommand}"
                    Margin="16,8" HorizontalOptions="Fill" />
            <Button Text="{loc:T Menu_Export}"
                    Command="{Binding GoToExportCommand}"
                    Margin="16,4" HorizontalOptions="Fill" />
            <Button Text="{loc:T Settings_UpdateManufacturers}"
                    Command="{Binding UpdateManufacturersCommand}"
                    Margin="16,4" HorizontalOptions="Fill" />
            <HorizontalStackLayout Margin="16,0,16,8" Spacing="8">
                <ActivityIndicator IsRunning="{Binding IsUpdatingManufacturers}" IsVisible="{Binding IsUpdatingManufacturers}"
                                   HeightRequest="20" />
                <Label Text="{Binding ManufacturersText}" FontSize="11" TextColor="Gray" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Updates -->
            <Label Text="{loc:T Settings_UPDATES}" Style="{StaticResource SectionHeader}" />
            <VerticalStackLayout IsVisible="{Binding UpdatesSupported}">
                <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                    <Label Grid.Column="0" Text="{loc:T Settings_CheckForUpdatesAtStartup}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding AutoCheckForUpdates}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                    <Label Grid.Column="0" Text="{loc:T Settings_IncludePreReleases}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding IncludePrereleaseUpdates}" />
                </Grid>
                <Label Text="{loc:T Settings_PreReleasesEG0}"
                       FontSize="11" TextColor="Gray" Margin="16,0,16,4" />
                <Button Text="{loc:T Settings_CheckForUpdates}"
                        Command="{Binding CheckForUpdatesCommand}"
                        Margin="16,8" HorizontalOptions="Fill" />
            </VerticalStackLayout>
            <!-- Where updates aren't offered (the Google Play build, iOS), say why instead -->
            <Label Text="{Binding UpdatesUnsupportedReason}" IsVisible="{Binding UpdatesUnsupported}"
                   Padding="16,8" />
            <Label Text="{Binding VersionText}" FontSize="12" TextColor="Gray" Margin="16,0,16,4" />
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,4" />

            <!-- Advanced -->
            <Label Text="{loc:T Settings_ADVANCED}" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                <Label Grid.Column="0" Text="{loc:T Settings_KeepScreenOnWhileScanning}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding KeepScreenOn}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                <Label Grid.Column="0" Text="{loc:T Settings_DebugLogging}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding DebugLogging}" />
            </Grid>
            <Label Text="{loc:T Settings_WritesGPSFixesAndMap}"
                   FontSize="11" TextColor="Gray" Margin="16,0,16,8" />

        </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
