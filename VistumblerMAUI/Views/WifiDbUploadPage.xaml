<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VistumblerMAUI.ViewModels"
             x:DataType="vm:WifiDbUploadViewModel"
             x:Class="VistumblerMAUI.Views.WifiDbUploadPage"
             Title="Upload to WifiDB">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,8">

            <Label Text="Uploads the current session's access points to WifiDB. WifiDB queues the file and imports it shortly after."
                   FontSize="12" TextColor="Gray" Margin="16,0,16,8" />

            <Label Text="ACCOUNT" Style="{StaticResource SectionHeader}" />
            <Label Text="{Binding AccountText}" Margin="16,4,16,4" />
            <Button Text="Set up WifiDB account"
                    Command="{Binding OpenWifiDbSettingsCommand}"
                    IsVisible="{Binding NeedsAccount}"
                    Margin="16,4" HorizontalOptions="Fill" />
            <Button Text="Change account in Settings"
                    Command="{Binding OpenWifiDbSettingsCommand}"
                    IsVisible="{Binding HasAccount}"
                    Margin="16,0,16,4" HorizontalOptions="Start" Padding="12,0" HeightRequest="32"
                    BackgroundColor="Transparent" TextColor="#1565C0" />
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,4" />

            <Label Text="UPLOAD" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Padding="16,8" ColumnSpacing="12" RowSpacing="8">
                <Label Grid.Row="0" Grid.Column="0" Text="Title" VerticalOptions="Center" />
                <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Title}" />

                <Label Grid.Row="1" Grid.Column="0" Text="Notes" VerticalOptions="Start" Margin="0,8,0,0" />
                <Editor Grid.Row="1" Grid.Column="1" Text="{Binding Notes}" HeightRequest="90" Placeholder="optional" />

                <Label Grid.Row="2" Grid.Column="0" Text="Other users" VerticalOptions="Center" />
                <Entry Grid.Row="2" Grid.Column="1" Text="{Binding OtherUsers}" Placeholder="optional, comma separated" />

                <Label Grid.Row="3" Grid.Column="0" Text="File type" VerticalOptions="Center" />
                <Picker Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" />
            </Grid>

            <!-- WiGLE, optional: only when turned on in Settings → WiGLE -->
            <Grid ColumnDefinitions="Auto,*" Padding="16,4" ColumnSpacing="8" IsVisible="{Binding ShowWigle}">
                <CheckBox Grid.Column="0" IsChecked="{Binding AlsoWigle}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding WigleText}" FontSize="13" VerticalOptions="Center" />
            </Grid>

            <Button Text="Upload" Command="{Binding UploadCommand}" Margin="16,8" HorizontalOptions="Fill" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="16,0" />
            <Label Text="{Binding StatusMessage}" Margin="16,8" />
            <Button Text="Check import status" Command="{Binding CheckStatusCommand}"
                    IsVisible="{Binding CanCheckStatus}"
                    Margin="16,0,16,4" HorizontalOptions="Fill"
                    BackgroundColor="Transparent" TextColor="#1565C0" />
            <Button Text="Close" Command="{Binding CloseCommand}"
                    Margin="16,4" HorizontalOptions="Fill"
                    BackgroundColor="Transparent" TextColor="Gray" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
