<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VistumblerMAUI.ViewModels"
             x:DataType="vm:GpsDetailsViewModel"
             x:Class="VistumblerMAUI.Views.GpsDetailsPage"
             Title="GPS details">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="{Binding Source}" FontAttributes="Bold" />
            <Label Text="{Binding Status}" FontSize="12" TextColor="Gray" />

            <Grid ColumnDefinitions="110,*" RowSpacing="6" ColumnSpacing="10"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Position" TextColor="Gray" />
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Position}" />
                <Label Grid.Row="1" Grid.Column="0" Text="Altitude" TextColor="Gray" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Altitude}" />
                <Label Grid.Row="2" Grid.Column="0" Text="Satellites" TextColor="Gray" />
                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Satellites}" />
                <Label Grid.Row="3" Grid.Column="0" Text="Accuracy" TextColor="Gray" />
                <Label Grid.Row="3" Grid.Column="1" Text="{Binding Accuracy}" />
                <Label Grid.Row="4" Grid.Column="0" Text="Speed" TextColor="Gray" />
                <Label Grid.Row="4" Grid.Column="1" Text="{Binding Speed}" />
                <Label Grid.Row="5" Grid.Column="0" Text="Heading" TextColor="Gray" />
                <Label Grid.Row="5" Grid.Column="1" Text="{Binding Heading}" />
                <Label Grid.Row="6" Grid.Column="0" Text="Fix quality" TextColor="Gray" />
                <Label Grid.Row="6" Grid.Column="1" Text="{Binding Quality}" />
                <Label Grid.Row="7" Grid.Column="0" Text="Fix time" TextColor="Gray" />
                <Label Grid.Row="7" Grid.Column="1" Text="{Binding FixTime}" />
            </Grid>

            <Label Text="COMPASS" FontSize="12" FontAttributes="Bold" TextColor="#1565C0" Margin="0,8,0,0" />
            <GraphicsView x:Name="CompassView" HeightRequest="240" WidthRequest="240" HorizontalOptions="Center" />
            <Label Text="Points along your direction of travel, as the GPS reports it while you're moving."
                   FontSize="11" TextColor="Gray" HorizontalOptions="Center" />

            <!-- Offline position from the APs in range, looked up in m8b files and the open session -->
            <Label Text="WI-FI POSITION (OFFLINE)" FontSize="12" FontAttributes="Bold" TextColor="#1565C0" Margin="0,16,0,0" />
            <Label Text="{Binding WifiPosition}" FontAttributes="Bold" />
            <Label Text="{Binding WifiPositionDetail}" FontSize="12" TextColor="Gray" />
            <Button Text="Show on map" Command="{Binding ShowWifiPositionOnMapCommand}"
                    IsVisible="{Binding HasWifiPosition}" HorizontalOptions="Start" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="Also search this session's APs" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding UseSessionAps}" />
            </Grid>

            <Label Text="Magic 8 Ball (m8b) files" FontAttributes="Bold" FontSize="13" Margin="0,6,0,0" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding M8bFiles}" Spacing="4">
                <BindableLayout.EmptyView>
                    <Label Text="None imported. Export one from a session (Export → M8b), or use one from WiGLE WiFi Wardriving."
                           FontSize="12" TextColor="Gray" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:M8bFileItem">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="13" LineBreakMode="MiddleTruncation" />
                                <Label Text="{Binding Detail}" FontSize="11" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Remove" FontSize="12" Padding="10,0" HeightRequest="36"
                                    BackgroundColor="Transparent" TextColor="#C62828"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GpsDetailsViewModel}}, Path=RemoveM8bCommand, x:DataType=vm:GpsDetailsViewModel}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="Import m8b file…" Command="{Binding ImportM8bCommand}" HorizontalOptions="Start" />
            <Label Text="{Binding M8bStatus}" FontSize="12" TextColor="Gray" />
            <Label FontSize="11" TextColor="Gray"
                   Text="Each AP in range votes for the 1 km squares it has been seen in; the square most agree on is the estimate. Works with no GPS or network, e.g. indoors. The m8b format comes from WiGLE WiFi Wardriving." />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
