<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VistumblerMAUI.ViewModels"
             xmlns:models="clr-namespace:Vistumbler.Core.Models;assembly=Vistumbler.Core"
             xmlns:controls="clr-namespace:VistumblerMAUI.Controls"
             xmlns:loc="clr-namespace:VistumblerMAUI.Localization"
             x:DataType="vm:ScanViewModel"
             x:Class="VistumblerMAUI.Views.ScanPage"
             Title="{loc:T Tab_Scan}">

    <ContentPage.Resources>
        <!-- One AP row, shared by the flat and the grouped list -->
        <DataTemplate x:Key="ApRowTemplate" x:DataType="models:AccessPoint">
            <Grid ColumnDefinitions="*,Auto,Auto" Padding="12,8" ColumnSpacing="8">
                <Grid.Triggers>
                    <!-- Dead (not re-seen within the timeout) APs are dimmed but stay listed. -->
                    <DataTrigger TargetType="Grid" Binding="{Binding IsActive}" Value="False">
                        <Setter Property="Opacity" Value="0.4" />
                    </DataTrigger>
                </Grid.Triggers>
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding Ssid}" FontAttributes="Bold" FontSize="14" />
                    <Label Text="{Binding Bssid}" FontSize="11" TextColor="Gray" />
                    <Label Text="{Binding Manufacturer}" FontSize="11" TextColor="Gray"
                           IsVisible="{Binding Manufacturer, Converter={StaticResource IsNotNullOrEmpty}}" />
                    <Label FontSize="10" TextColor="Gray" Text="{Binding FirstSeenText, StringFormat={loc:T Scan_FirstSeen}}" />
                    <Label FontSize="10" TextColor="Gray" Text="{Binding LastSeenText, StringFormat={loc:T Scan_LastSeen}}" />
                    <Label FontSize="10" TextColor="Gray"
                           Text="{Binding GpsText, StringFormat='⌖ {0}'}"
                           IsVisible="{Binding HasGps}" />
                </VerticalStackLayout>
                <!-- Signal % + RSSI -->
                <VerticalStackLayout Grid.Column="1" WidthRequest="64" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding Signal, StringFormat='{0}%'}" HorizontalOptions="Center" FontSize="13" />
                    <ProgressBar Progress="{Binding Signal, Converter={StaticResource IntToProgress}}" HeightRequest="6" />
                    <Label Text="{Binding Rssi, StringFormat={loc:T ApDetails_0DBm}}" HorizontalOptions="Center" FontSize="10" TextColor="Gray" />
                </VerticalStackLayout>
                <!-- Channel + band + security (authentication AND encryption) -->
                <VerticalStackLayout Grid.Column="2" WidthRequest="96" HorizontalOptions="End" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding Channel, StringFormat={loc:T Scan_Channel}}" FontSize="12" HorizontalOptions="End" />
                    <Label Text="{Binding FrequencyMhz, Converter={StaticResource FreqToBand}}" FontSize="10" TextColor="Gray" HorizontalOptions="End" />
                    <Label Text="{Binding AuthText}" FontSize="10" TextColor="#546E7A" HorizontalOptions="End" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding EncryptionText}" FontSize="10" TextColor="#78909C" HorizontalOptions="End" />
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- The scan/GPS toggles and counts take the title bar; the tab already says which page this is -->
    <Shell.TitleView>
        <controls:ScanControlBar x:Name="ScanBar" />
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- One-off messages and the Save & Clear total, only while there are any -->
        <controls:NoticeBar x:Name="Notices" Grid.Row="0" />

        <!-- Search, then sort (a menu with the sort fields, reverse and Group by, which is the phone version of
             the original's tree view) and the filters (the list of saved filters) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Padding="8,4" ColumnSpacing="2">
            <SearchBar Grid.Column="0"
                       Text="{Binding SearchText}"
                       Placeholder="{loc:T Scan_SearchPlaceholder}" />
            <Button Grid.Column="1"
                    Text="{Binding SortButtonText, StringFormat='⇅ {0}'}"
                    Command="{Binding OpenSortMenuCommand}"
                    IsVisible="{Binding IsWifiList}"
                    MaximumWidthRequest="130"
                    LineBreakMode="TailTruncation"
                    Padding="8,0"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}" FontSize="13" />
            <Button Grid.Column="2"
                    Text="{Binding FilterLabel, StringFormat='⏷ {0}'}"
                    Command="{Binding OpenFiltersCommand}"
                    MaximumWidthRequest="130"
                    LineBreakMode="TailTruncation"
                    Padding="8,0"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}" FontSize="13" />
        </Grid>

        <!-- Which list (Wi-Fi, Bluetooth, cells), only on devices that record more than Wi-Fi -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Padding="12,0,12,4" ColumnSpacing="8"
              IsVisible="{Binding HasListTypes}">
            <Picker Grid.Column="0" FontSize="13" WidthRequest="110"
                    ItemsSource="{Binding ListTypes}"
                    ItemDisplayBinding="{Binding ., Converter={StaticResource LocValue}, x:DataType=x:String}"
                    SelectedItem="{Binding SelectedListType}" />
            <Label Grid.Column="1" FontSize="12" TextColor="Gray" VerticalOptions="Center"
                   IsVisible="{Binding IsWifiList, Converter={StaticResource InvertBool}}"
                   Text="{Binding RadioNetworks.Count, StringFormat={loc:T Scan_RadioShown}}" />
        </Grid>

        <!-- AP list -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding AccessPoints}"
                        ItemTemplate="{StaticResource ApRowTemplate}"
                        IsVisible="{Binding ShowFlatWifiList}"
                        SelectionMode="Single"
                        SelectionChanged="OnApSelected" />

        <!-- Grouped AP list: tap a header to collapse or expand it -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Groups}"
                        IsGrouped="True"
                        ItemTemplate="{StaticResource ApRowTemplate}"
                        IsVisible="{Binding ShowGroupedWifiList}"
                        SelectionMode="Single"
                        SelectionChanged="OnApSelected">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:ApGroup">
                    <Label Text="{Binding Header}" FontAttributes="Bold" FontSize="13" Padding="12,8"
                           BackgroundColor="{AppThemeBinding Light=#ECEFF1, Dark=#263238}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ScanViewModel}}, Path=ToggleGroupCommand, x:DataType=vm:ScanViewModel}"
                                CommandParameter="{Binding .}" />
                        </Label.GestureRecognizers>
                    </Label>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
        </CollectionView>

        <!-- Bluetooth devices or cell towers (ScanViewModel.Radio.cs) -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding RadioNetworks}"
                        IsVisible="{Binding IsWifiList, Converter={StaticResource InvertBool}}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="{loc:T Scan_RadioEmpty}"
                       FontSize="13" TextColor="Gray" HorizontalOptions="Center" Margin="16,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RadioNetwork">
                    <Grid ColumnDefinitions="*,Auto" Padding="12,8" ColumnSpacing="8">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="14" />
                            <Label Text="{Binding Key}" FontSize="11" TextColor="Gray" />
                            <Label Text="{Binding Manufacturer}" FontSize="11" TextColor="Gray"
                                   IsVisible="{Binding Manufacturer, Converter={StaticResource IsNotNullOrEmpty}}" />
                            <Label FontSize="10" TextColor="Gray" Text="{Binding LastSeenText, StringFormat={loc:T Scan_LastSeen}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" WidthRequest="110" HorizontalOptions="End" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Rssi, StringFormat={loc:T ApDetails_0DBm}}" FontSize="13" HorizontalOptions="End" />
                            <Label Text="{Binding TypeText}" FontSize="10" TextColor="#546E7A" HorizontalOptions="End" />
                            <Label Text="{Binding CapabilitiesText}" FontSize="10" TextColor="#78909C" HorizontalOptions="End"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Channel, StringFormat={loc:T Scan_Channel}}" FontSize="10" TextColor="Gray" HorizontalOptions="End"
                                   IsVisible="{Binding IsCell}" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom hint -->
        <Label Grid.Row="4" Text="{loc:T Scan_TapToBegin}" HorizontalOptions="Center"
               FontSize="12" TextColor="Gray" Padding="8"
               IsVisible="{Binding IsScanning, Converter={StaticResource InvertBool}}" />
    </Grid>

</ContentPage>
