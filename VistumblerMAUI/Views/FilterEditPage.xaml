<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:VistumblerMAUI.Localization"
             xmlns:vm="clr-namespace:VistumblerMAUI.ViewModels"
             x:DataType="vm:FilterEditViewModel"
             x:Class="VistumblerMAUI.Views.FilterEditPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="0,8" Spacing="0">

            <Grid ColumnDefinitions="Auto,*" Padding="16,8" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{loc:T FilterEdit_Name}" VerticalOptions="Center" />
                <Entry Grid.Column="1" Text="{Binding Filter.Name}" />
            </Grid>
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,4" />

            <Label Text="{loc:T FilterEdit_SHOWAPSTHAT}" Style="{StaticResource SectionHeader}" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Padding="16,8" ColumnSpacing="12" RowSpacing="8">
                <Label Grid.Row="0" Grid.Column="0" Text="{loc:T FilterEdit_SSIDContains}" VerticalOptions="Center" />
                <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Filter.SsidContains}" Placeholder="{loc:T FilterEdit_Any}" />
                <Label Grid.Row="1" Grid.Column="0" Text="{loc:T FilterEdit_BSSIDStartsWith}" VerticalOptions="Center" />
                <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Filter.BssidStartsWith}" Placeholder="{loc:T FilterEdit_AnyEG0011}" />
                <Label Grid.Row="2" Grid.Column="0" Text="{loc:T Tab_Channels}" VerticalOptions="Center" />
                <Entry Grid.Row="2" Grid.Column="1" Text="{Binding Filter.Channels}" Placeholder="{loc:T FilterEdit_AnyEG16}" />
                <Label Grid.Row="3" Grid.Column="0" Text="{loc:T FilterEdit_SignalAtLeast}" VerticalOptions="Center" />
                <Entry Grid.Row="3" Grid.Column="1" Text="{Binding MinSignalText}" Placeholder="{loc:T FilterEdit_Any}" Keyboard="Numeric" />
            </Grid>

            <Label Text="{loc:T Opt_Security}" Margin="16,8,16,0" />
            <HorizontalStackLayout Padding="12,0" Spacing="4">
                <CheckBox IsChecked="{Binding Filter.Open}" /><Label Text="{loc:T Group_Open}" VerticalOptions="Center" Margin="0,0,12,0" />
                <CheckBox IsChecked="{Binding Filter.Wep}" /><Label Text="{loc:T FilterEdit_WEP}" VerticalOptions="Center" Margin="0,0,12,0" />
                <CheckBox IsChecked="{Binding Filter.Secure}" /><Label Text="{loc:T FilterEdit_SecureWPAAndUp}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="{loc:T Channels_Band}" Margin="16,8,16,0" />
            <HorizontalStackLayout Padding="12,0" Spacing="4">
                <CheckBox IsChecked="{Binding Filter.Band24}" /><Label Text="{loc:T FilterEdit_24GHz}" VerticalOptions="Center" Margin="0,0,12,0" />
                <CheckBox IsChecked="{Binding Filter.Band5}" /><Label Text="{loc:T FilterEdit_5GHz}" VerticalOptions="Center" Margin="0,0,12,0" />
                <CheckBox IsChecked="{Binding Filter.Band6}" /><Label Text="{loc:T FilterEdit_6GHz}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Picker Margin="16,8" ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding SelectedStatus}" />
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,4" />

            <!-- Advanced: the original Vistumbler's per-field filter expressions -->
            <Grid ColumnDefinitions="*,Auto" Padding="16,8">
                <Label Grid.Column="0" Text="{loc:T FilterEdit_AdvancedRules}" FontAttributes="Bold" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ShowAdvanced}" />
            </Grid>
            <VerticalStackLayout IsVisible="{Binding ShowAdvanced}" Padding="16,0,16,8" Spacing="8">
                <Label FontSize="11" TextColor="Gray"
                       Text="{loc:T FilterEdit_TheOriginalVistumblerSFilter}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="6"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <Label Grid.Row="0" Grid.Column="0" Text="{loc:T Opt_SSID}" VerticalOptions="Center" />
                    <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Filter.AdvSsid}" />
                    <Label Grid.Row="1" Grid.Column="0" Text="{loc:T Opt_BSSID}" VerticalOptions="Center" />
                    <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Filter.AdvBssid}" />
                    <Label Grid.Row="2" Grid.Column="0" Text="{loc:T Opt_Channel}" VerticalOptions="Center" />
                    <Entry Grid.Row="2" Grid.Column="1" Text="{Binding Filter.AdvChannel}" />
                    <Label Grid.Row="3" Grid.Column="0" Text="{loc:T Opt_Authentication}" VerticalOptions="Center" />
                    <Entry Grid.Row="3" Grid.Column="1" Text="{Binding Filter.AdvAuth}" Placeholder="{loc:T FilterEdit_EGWPA2PersonalWPA3}" />
                    <Label Grid.Row="4" Grid.Column="0" Text="{loc:T Opt_Encryption}" VerticalOptions="Center" />
                    <Entry Grid.Row="4" Grid.Column="1" Text="{Binding Filter.AdvEncr}" Placeholder="{loc:T FilterEdit_EGCCMP}" />
                    <Label Grid.Row="5" Grid.Column="0" Text="{loc:T FilterEdit_RadioType}" VerticalOptions="Center" />
                    <Entry Grid.Row="5" Grid.Column="1" Text="{Binding Filter.AdvRadio}" Placeholder="{loc:T FilterEdit_EG5GHz}" />
                    <Label Grid.Row="6" Grid.Column="0" Text="{loc:T Opt_Networktype}" VerticalOptions="Center" />
                    <Entry Grid.Row="6" Grid.Column="1" Text="{Binding Filter.AdvNetType}" Placeholder="{loc:T FilterEdit_InfrastructureOrAdHoc}" />
                    <Label Grid.Row="7" Grid.Column="0" Text="{loc:T FilterEdit_Signal}" VerticalOptions="Center" />
                    <Entry Grid.Row="7" Grid.Column="1" Text="{Binding Filter.AdvSignal}" />
                    <Label Grid.Row="8" Grid.Column="0" Text="{loc:T FilterEdit_HighSignal}" VerticalOptions="Center" />
                    <Entry Grid.Row="8" Grid.Column="1" Text="{Binding Filter.AdvHighSignal}" />
                    <Label Grid.Row="9" Grid.Column="0" Text="{loc:T FilterEdit_RSSIDBm}" VerticalOptions="Center" />
                    <Entry Grid.Row="9" Grid.Column="1" Text="{Binding Filter.AdvRssi}" Placeholder="{loc:T FilterEdit_EG700}" />
                    <Label Grid.Row="10" Grid.Column="0" Text="{loc:T FilterEdit_HighRSSIDBm}" VerticalOptions="Center" />
                    <Entry Grid.Row="10" Grid.Column="1" Text="{Binding Filter.AdvHighRssi}" />
                    <Label Grid.Row="11" Grid.Column="0" Text="{loc:T FilterEdit_Active1Or0}" VerticalOptions="Center" />
                    <Entry Grid.Row="11" Grid.Column="1" Text="{Binding Filter.AdvActive}" />
                </Grid>
            </VerticalStackLayout>
            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="16,4" />

            <Button Text="{loc:T FilterEdit_SaveAndUse}" Command="{Binding SaveAndUseCommand}" Margin="16,8,16,4" HorizontalOptions="Fill" />
            <Button Text="{loc:T FilterEdit_Save}" Command="{Binding SaveCommand}" Margin="16,4" HorizontalOptions="Fill"
                    BackgroundColor="Transparent" TextColor="#1565C0" />
            <Button Text="{loc:T Common_Cancel}" Command="{Binding CancelCommand}" Margin="16,0,16,8" HorizontalOptions="Fill"
                    BackgroundColor="Transparent" TextColor="Gray" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
