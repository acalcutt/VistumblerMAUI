<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:VistumblerMAUI.Views"
       xmlns:services="clr-namespace:VistumblerMAUI.Services"
       xmlns:loc="clr-namespace:VistumblerMAUI.Localization"
       x:Class="VistumblerMAUI.AppShell"
       Shell.FlyoutBehavior="Flyout"
       FlyoutHeaderBehavior="Fixed"
       Title="VistumblerMAUI">

    <!-- Bottom tabs (primary navigation) -->
    <TabBar>
        <ShellContent Title="{loc:T Tab_Scan}"
                      Icon="tab_scan.png"
                      ContentTemplate="{DataTemplate views:ScanPage}"
                      Route="ScanPage" />
        <ShellContent Title="{loc:T Tab_Map}"
                      Icon="tab_map.png"
                      ContentTemplate="{DataTemplate views:MapPage}"
                      Route="MapPage" />
        <ShellContent Title="{loc:T Tab_Channels}"
                      Icon="tab_map.png"
                      ContentTemplate="{DataTemplate views:ChannelGraphPage}"
                      Route="ChannelGraphPage" />
        <ShellContent Title="{loc:T Tab_Settings}"
                      Icon="tab_settings.png"
                      ContentTemplate="{DataTemplate views:SettingsPage}"
                      Route="SettingsPage" />
    </TabBar>

    <!-- Hamburger menu actions (data + session) -->
    <MenuItem Text="{loc:T Menu_NewSession}"    Clicked="OnNewSessionClicked" />
    <MenuItem Text="{loc:T Menu_Import}"        Clicked="OnImportClicked" />
    <MenuItem Text="{loc:T Menu_Export}"        Clicked="OnExportClicked" />
    <!-- Clears the AP list, offering to save it first (the original's Save &amp; Clear and Clear All) -->
    <MenuItem Text="{loc:T Menu_Clear}"         Clicked="OnClearClicked" />
    <MenuItem Text="{loc:T Menu_UploadWifiDb}"  Clicked="OnUploadToWifiDbClicked" />
    <!-- Hidden where there's nothing to check, e.g. the Google Play build, which Play updates -->
    <MenuItem Text="{loc:T Menu_CheckForUpdates}" Clicked="OnCheckForUpdatesClicked"
              Shell.FlyoutItemIsVisible="{x:Static services:AppUpdater.IsSupported}" />
    <MenuItem Text="{loc:T Menu_GpsDetails}"    Clicked="OnGpsDetailsClicked" />
    <MenuItem Text="{loc:T Menu_SiteSurvey}"    Clicked="OnSurveyClicked" />
    <MenuItem Text="{loc:T Menu_Links}"         Clicked="OnLinksClicked" />
    <MenuItem Text="{loc:T Menu_ExitSaveDb}"    Clicked="OnExitSaveClicked" />
    <MenuItem Text="{loc:T Menu_Exit}"          Clicked="OnExitDiscardClicked" />

</Shell>
